<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="using:VideoEmpty.Core.Model"
        xmlns:local="using:VideoEmpty.UI"
        x:Class="VideoEmpty.UI.MainWindow"
        Title="VideoEmpty" Width="1360" Height="860">
    <Window.Styles>
        <!-- Hide action icon buttons by default; reveal when the row is hovered. -->
        <Style Selector="ListBoxItem StackPanel.item-actions">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover StackPanel.item-actions">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <!-- Make the small icon buttons compact and low-key. -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button#DashboardInstallDepsButton">
            <Setter Property="Background" Value="#6E5311"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2BD5A"/>
        </Style>
        <Style Selector="Button#DashboardInstallDepsButton:pointerover">
            <Setter Property="Background" Value="#826116"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#F0CC72"/>
        </Style>
        <Style Selector="Button#DashboardInstallDepsButton:pressed">
            <Setter Property="Background" Value="#5A430D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0A945"/>
        </Style>
        <Style Selector="Button#DashboardInstallDepsButton /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button#DashboardInstallDepsButton:pointerover /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button#DashboardInstallDepsButton:pressed /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="ProgressBar#DashboardInstallProgress">
            <Setter Property="Background" Value="#2F2409"/>
            <Setter Property="Foreground" Value="#FFD675"/>
            <Setter Property="BorderBrush" Value="#E2BD5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="280"/>
            <Setter Property="Height" Value="12"/>
        </Style>
    </Window.Styles>
    <Grid>
        <DockPanel x:Name="DashboardRoot" IsVisible="True" Margin="12">
            <TextBlock DockPanel.Dock="Top" Text="VideoEmpty Dashboard" FontSize="26" FontWeight="Bold" Margin="0,0,0,10"/>
            <Border x:Name="DashboardDependencyPanel" DockPanel.Dock="Top" IsVisible="False"
                    Background="#4A3B12" BorderBrush="#C89A2B" BorderThickness="1"
                    Padding="10" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="DashboardDependencyMessage"
                               Text="FFmpeg is required before you can create or open projects."
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DashboardInstallDepsButton"
                                Content="Install missing library…"
                                />
                        <TextBlock x:Name="DashboardInstallStatus"
                                   VerticalAlignment="Center"
                                   Foreground="White"/>
                    </StackPanel>
                    <ProgressBar x:Name="DashboardInstallProgress" IsVisible="False" IsIndeterminate="True"/>
                </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                <Button x:Name="DashboardNewProjectButton" Content="New Project…"/>
                <Button x:Name="DashboardOpenProjectButton" Content="Open Project…"/>
                <Button x:Name="DashboardOpenLogButton" Content="Open Log"/>
            </StackPanel>
            <TextBlock Text="Recent Projects" FontWeight="Bold" Margin="0,4,0,8"/>
            <ListBox x:Name="RecentProjectsList">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="local:RecentProjectItem">
                        <Grid ColumnDefinitions="*,Auto" Margin="2,4">
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding Path}" FontSize="10" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" Spacing="2" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Created" FontSize="10" Foreground="Gray"/>
                                    <TextBlock Text="{Binding CreatedLabel}" FontSize="10" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Updated" FontSize="10" Foreground="Gray"/>
                                    <TextBlock Text="{Binding UpdatedLabel}" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel x:Name="EditorRoot" IsVisible="False">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
                <Button x:Name="DashboardButton" Content="Dashboard"/>
                <Button x:Name="OpenVideoButton" Content="Open Video…"/>
                <Button x:Name="SaveProjectButton" Content="Save Project…"/>
                <Button x:Name="UndoButton" Content="Undo"/>
                <Button x:Name="ShiftInstancesButton" Content="Shift Times…" ToolTip.Tip="Bulk-shift StartMs of all instances (or those before/after the selected one). Use this to undo a bad video-replace shift."/>
                <Button x:Name="ExportButton" Content="Export Video…" ToolTip.Tip="Export the video with captions"/>
                <Button x:Name="ExportSubtitlesButton" Content="Export Subtitles…" ToolTip.Tip="Export captions as .srt, .vtt, or .json"/>
                <Button x:Name="ExportCapCutButton" Content="Export to CapCut… (Preview)" ToolTip.Tip="[Preview] Append all template instances into an existing CapCut PC project (creates a clone by default). This feature is in preview - geometry, fonts and animations are still being calibrated; review the result in CapCut before relying on it."/>
                <Separator/>
                <Button x:Name="TogglePanelsButton" Content="◄ ► Layout" ToolTip.Tip="Toggle left/right panels"/>
                <Button x:Name="CompactModeButton" Content="⛶ Compact" ToolTip.Tip="Maximize video, hide panels"/>
                <Separator/>
                <Button x:Name="SettingsButton" Content="Settings…"/>
                <Button x:Name="InstallDepsButton" Content="Install FFmpeg…" IsVisible="False"/>
                <Button x:Name="OpenLogButton" Content="Open Log"/>
                <TextBlock x:Name="VideoInfoLabel" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>

            <StackPanel x:Name="CompactTemplatesToolbar" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="4" IsVisible="False">
                <TextBlock Text="Templates:" VerticalAlignment="Center" Foreground="Gray" Margin="4,0"/>
                <ListBox x:Name="CompactTemplatesListBox" Height="40" HorizontalAlignment="Stretch">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="model:Template">
                            <Button Tag="{Binding Id}" Content="{Binding Name}" Padding="8,4" 
                                    Click="OnCompactTemplateButtonClicked" ToolTip.Tip="{Binding Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Background="#222" Padding="6,3">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="ArmedLabel" Foreground="White" Text="(none armed)"/>
                    <TextBlock x:Name="TimeLabel" Foreground="White"/>
                    <TextBlock x:Name="ExportStatus" Foreground="LightGreen"/>
                </StackPanel>
            </Border>

            <Grid x:Name="MainEditorGrid" ColumnDefinitions="360,Auto,*,Auto,340">
                <Border x:Name="LeftTemplatePanel" Grid.Column="0" BorderBrush="#444" BorderThickness="0,0,1,0" Padding="6">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Text="Templates" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="CollapseLeftButton" Classes="icon-btn"
                                    Content="◄" ToolTip.Tip="Collapse this panel" Padding="6,1"/>
                        </Grid>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                            <Button x:Name="AddTemplateButton" Content="Add"/>
                            <Button x:Name="DuplicateTemplateButton" Content="Duplicate"/>
                            <Button x:Name="DeleteTemplateButton" Content="Delete"/>
                        </StackPanel>
                        <ScrollViewer DockPanel.Dock="Bottom" x:Name="TemplateEditorScroll" IsVisible="False" MaxHeight="540" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="TemplateEditor" Spacing="6">
                                <TextBlock Text="Selected template" FontWeight="Bold"/>
                                <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="4">
                                    <TextBlock Text="Name" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TemplateNameBox"/>
                                    <TextBlock Grid.Row="1" Text="Width" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TemplateWidthBox"/>
                                    <TextBlock Grid.Row="2" Text="Height" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TemplateHeightBox"/>
                                    <TextBlock Grid.Row="3" Text="Default ms" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="TemplateDurationBox"/>
                                    <TextBlock Grid.Row="4" Text="Enter" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="TemplateEnterBox" HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Row="5" Text="Exit" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="TemplateExitBox" HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Row="6" Text="Enter/Exit ms" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <TextBox x:Name="TemplateEnterMsBox" Width="80"/>
                                        <TextBox x:Name="TemplateExitMsBox" Width="80"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="7" Text="Sound enter" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="7" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                        <TextBox x:Name="TemplateSoundEnterBox"/>
                                        <Button Grid.Column="1" x:Name="TemplateSoundEnterBrowse" Content="…" Padding="6,1"/>
                                        <Button Grid.Column="2" x:Name="TemplateSoundEnterClear" Content="✕" Padding="6,1"/>
                                    </Grid>
                                    <TextBlock Grid.Row="8" Text="Sound exit" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="8" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                        <TextBox x:Name="TemplateSoundExitBox"/>
                                        <Button Grid.Column="1" x:Name="TemplateSoundExitBrowse" Content="…" Padding="6,1"/>
                                        <Button Grid.Column="2" x:Name="TemplateSoundExitClear" Content="✕" Padding="6,1"/>
                                    </Grid>
                                    <TextBlock Grid.Row="9" Text="Sound volume" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="9" Grid.Column="1" ColumnDefinitions="*,40" ColumnSpacing="6">
                                        <Slider x:Name="TemplateSoundVolumeSlider" Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.1" IsSnapToTickEnabled="False"/>
                                        <TextBlock Grid.Column="1" x:Name="TemplateSoundVolumeLabel" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>

                                <Border BorderBrush="#444" BorderThickness="0,1,0,0" Margin="0,4,0,0"/>
                                <TextBlock Text="Elements" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button x:Name="AddShapeElementButton" Content="+ Shape"/>
                                    <Button x:Name="AddTextElementButton" Content="+ Text"/>
                                    <Button x:Name="DuplicateElementButton" Content="Duplicate"/>
                                    <Button x:Name="DeleteElementButton" Content="Delete"/>
                                    <Button x:Name="MoveElementUpButton" Content="↑" ToolTip.Tip="Move up"/>
                                    <Button x:Name="MoveElementDownButton" Content="↓" ToolTip.Tip="Move down"/>
                                </StackPanel>
                                <ListBox x:Name="ElementsList" Height="120">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="local:ElementListItem">
                                            <StackPanel Orientation="Horizontal" Spacing="6" MinHeight="22">
                                                <TextBlock Text="{Binding Icon}" FontSize="14"/>
                                                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel x:Name="ElementEditorPanel" IsVisible="False" Spacing="4">
                                    <Border BorderBrush="#444" BorderThickness="0,1,0,0"/>
                                    <TextBlock x:Name="ElementEditorHeader" Text="Element" FontWeight="Bold"/>
                                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="4">
                                        <TextBlock Text="Offset X" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="ElementOffsetXBox"/>
                                        <TextBlock Grid.Row="1" Text="Offset Y" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ElementOffsetYBox"/>
                                        <TextBlock Grid.Row="2" Text="Width" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ElementWidthBox"/>
                                        <TextBlock Grid.Row="3" Text="Height" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="ElementHeightBox"/>
                                    </Grid>

                                    <StackPanel x:Name="ShapeElementEditor" IsVisible="False" Spacing="4">
                                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="4">
                                            <TextBlock Text="Shape" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" x:Name="ShapeKindBox" HorizontalAlignment="Stretch"/>
                                            <TextBlock Grid.Row="1" Text="Fill" VerticalAlignment="Center"/>
                                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="28,*" ColumnSpacing="4">
                                                <Border x:Name="ShapeFillSwatch" BorderBrush="#888" BorderThickness="1" Width="24" Height="24"/>
                                                <TextBox Grid.Column="1" x:Name="ShapeFillBox"/>
                                            </Grid>
                                            <TextBlock Grid.Row="2" Text="Border" VerticalAlignment="Center"/>
                                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="28,*" ColumnSpacing="4">
                                                <Border x:Name="ShapeBorderSwatch" BorderBrush="#888" BorderThickness="1" Width="24" Height="24"/>
                                                <TextBox Grid.Column="1" x:Name="ShapeBorderColorBox"/>
                                            </Grid>
                                            <TextBlock Grid.Row="3" Text="Border thick" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="ShapeBorderThicknessBox"/>
                                            <TextBlock Grid.Row="4" Text="Corner radius" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="ShapeCornerRadiusBox"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="TextElementEditor" IsVisible="False" Spacing="4">
                                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="4">
                                            <TextBlock Text="Font family" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" x:Name="TextFontFamilyBox"/>
                                            <TextBlock Grid.Row="1" Text="Font size" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TextFontSizeBox"/>
                                            <TextBlock Grid.Row="2" Text="Style" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                                <CheckBox x:Name="TextBoldBox" Content="Bold"/>
                                                <CheckBox x:Name="TextItalicBox" Content="Italic"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="3" Text="Color" VerticalAlignment="Center"/>
                                            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="28,*" ColumnSpacing="4">
                                                <Border x:Name="TextColorSwatch" BorderBrush="#888" BorderThickness="1" Width="24" Height="24"/>
                                                <TextBox Grid.Column="1" x:Name="TextColorBox"/>
                                            </Grid>
                                            <TextBlock Grid.Row="4" Text="H Align" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="TextHAlignBox" HorizontalAlignment="Stretch"/>
                                            <TextBlock Grid.Row="5" Text="V Align" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="TextVAlignBox" HorizontalAlignment="Stretch"/>
                                            <TextBlock Grid.Row="6" Text="Line spacing" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="6" Grid.Column="1" x:Name="TextLineSpacingBox"/>
                                            <TextBlock Grid.Row="7" Text="Default text" VerticalAlignment="Top"/>
                                            <TextBox Grid.Row="7" Grid.Column="1" x:Name="TextDefaultTextBox" AcceptsReturn="True" Height="60"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <Expander Header="Advanced (JSON)" IsExpanded="False" Margin="0,4,0,0">
                                    <StackPanel Spacing="4">
                                        <TextBox x:Name="TemplateJsonBox" AcceptsReturn="True" Height="170" TextWrapping="NoWrap" FontFamily="Consolas"/>
                                        <Button x:Name="ApplyTemplateJsonButton" Content="Apply JSON"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                        <ListBox x:Name="TemplatesList">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="model:Template">
                                    <Grid ColumnDefinitions="*,Auto" MinHeight="26">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                                    Classes="item-actions" VerticalAlignment="Center">
                                            <Button Classes="icon-btn" Content="⧉" ToolTip.Tip="Duplicate"
                                                    Tag="{Binding Id}" Click="OnTemplateItemDuplicate"/>
                                            <Button Classes="icon-btn" Content="✕" ToolTip.Tip="Delete"
                                                    Tag="{Binding Id}" Click="OnTemplateItemDelete"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" Background="#333" Cursor="SizeWestEast"/>

                <DockPanel Grid.Column="2" Margin="6">
                    <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,4,0,0">
                        <Slider x:Name="TimeSlider" Minimum="0" Maximum="1" Value="0"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <Button x:Name="JumpBack10sButton"  Content="«10s" ToolTip.Tip="Back 10 seconds (Ctrl+Alt+Left)"/>
                            <Button x:Name="JumpBack1sButton"   Content="«1s"  ToolTip.Tip="Back 1 second"/>
                            <Button x:Name="StepBackButton"     Content="◄|"   ToolTip.Tip="Previous frame"/>
                            <Button x:Name="PlayPauseButton"    Content="▶ Play" MinWidth="80"/>
                            <Button x:Name="StepForwardButton"  Content="|►"   ToolTip.Tip="Next frame"/>
                            <Button x:Name="JumpForward1sButton" Content="1s»" ToolTip.Tip="Forward 1 second"/>
                            <Button x:Name="JumpForward10sButton" Content="10s»" ToolTip.Tip="Forward 10 seconds (Ctrl+Alt+Right)"/>
                            <CheckBox x:Name="LoopCheck" Content="Loop" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock x:Name="PlaybackTimeLabel" VerticalAlignment="Center" Margin="12,0,0,0" Text="0:00.000 / 0:00.000"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#111">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform"/>
                            <Canvas x:Name="PlacementOverlay" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </DockPanel>

                <GridSplitter Grid.Column="3" Width="4" Background="#333" Cursor="SizeWestEast"/>

                <DockPanel x:Name="RightPropertiesPanel" Grid.Column="4" Margin="6">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                        <Button x:Name="CollapseRightButton" Classes="icon-btn"
                                Content="►" ToolTip.Tip="Collapse this panel" Padding="6,1"/>
                        <TextBlock Grid.Column="1" Text="Instances" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                    <StackPanel x:Name="InstanceEditor" DockPanel.Dock="Bottom" Spacing="4" IsVisible="False" Margin="0,8,0,0">
                        <TextBlock Text="Selected instance" FontWeight="Bold"/>
                        <TextBlock x:Name="InstanceTemplateNameLabel" FontSize="11" Foreground="Gray"/>
                        <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="6">
                            <TextBlock Text="Start ms"/>      <TextBox Grid.Column="1" x:Name="InstanceStartBox"/>
                            <TextBlock Grid.Row="1" Text="Duration ms"/> <TextBox Grid.Row="1" Grid.Column="1" x:Name="InstanceDurationBox"/>
                            <TextBlock Grid.Row="2" Text="Center X"/>    <TextBox Grid.Row="2" Grid.Column="1" x:Name="InstanceXBox"/>
                            <TextBlock Grid.Row="3" Text="Center Y"/>    <TextBox Grid.Row="3" Grid.Column="1" x:Name="InstanceYBox"/>
                        </Grid>
                        <TextBlock Text="Text rows (mapped to template text elements)" FontSize="11" Foreground="Gray"/>
                        <ListBox x:Name="InstanceTextFieldsList" MaxHeight="200"
                                 KeyboardNavigation.TabNavigation="Continue">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="local:InstanceTextFieldItem">
                                    <Grid ColumnDefinitions="60,*" RowDefinitions="Auto" Margin="0,2">
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>
                                        <TextBox Grid.Column="1"
                                                 Tag="{Binding ElementId}"
                                                 Text="{Binding Value}"
                                                 AcceptsReturn="True"
                                                 MinHeight="44"
                                                 KeyDown="OnInstanceTextFieldKeyDown"
                                                 LostFocus="OnInstanceTextFieldLostFocus"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="PreviewInstanceButton" Content="▶ Jump to" ToolTip.Tip="Jump video to start of this instance"/>
                            <Button x:Name="DeleteInstanceButton" Content="Delete"/>
                        </StackPanel>
                    </StackPanel>
                    <ListBox x:Name="InstancesList">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="local:InstanceListItem">
                                <Grid ColumnDefinitions="*,Auto" MinHeight="30">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding TextPreview}" FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding TextPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding TimeLabel}" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text="{Binding TemplateName}" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                                Classes="item-actions" VerticalAlignment="Center">
                                        <Button Classes="icon-btn" Content="▶" ToolTip.Tip="Jump to start"
                                                Tag="{Binding Instance.Id}" Click="OnInstanceItemPreview"/>
                                        <Button Classes="icon-btn" Content="✕" ToolTip.Tip="Delete"
                                                Tag="{Binding Instance.Id}" Click="OnInstanceItemDelete"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </DockPanel>

        <!-- Edge re-expand tabs (visible when a panel is collapsed) -->
        <Button x:Name="ExpandLeftEdgeButton" IsVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Width="18" Height="80" Padding="0"
                Background="#444" Foreground="White"
                Content="▶" FontSize="11" ToolTip.Tip="Show templates panel"/>
        <Button x:Name="ExpandRightEdgeButton" IsVisible="False"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Width="18" Height="80" Padding="0"
                Background="#444" Foreground="White"
                Content="◀" FontSize="11" ToolTip.Tip="Show properties panel"/>

        <!-- Compact-mode floating instance text-input overlay -->
        <Border x:Name="CompactInstanceOverlay" IsVisible="False"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,90,12,0" Padding="10"
                Background="#222" BorderBrush="#666" BorderThickness="1"
                MinWidth="320" MaxWidth="420">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                    <TextBlock x:Name="CompactOverlayTitle" Text="New caption" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="CompactOverlayExpandButton" Classes="icon-btn"
                            Content="⛶" ToolTip.Tip="Show full properties panel" Padding="6,1"/>
                    <Button Grid.Column="2" x:Name="CompactOverlayCloseButton" Classes="icon-btn"
                            Content="✕" ToolTip.Tip="Close" Padding="6,1" Margin="2,0,0,0"/>
                </Grid>
                <ListBox x:Name="CompactOverlayFieldsList" Background="Transparent"
                         KeyboardNavigation.TabNavigation="Continue" MaxHeight="320">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="local:InstanceTextFieldItem">
                            <Grid ColumnDefinitions="60,*" RowDefinitions="Auto" Margin="0,3">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="11" Foreground="#bbb"/>
                                <TextBox Grid.Column="1"
                                         Tag="{Binding ElementId}"
                                         Text="{Binding Value}"
                                         AcceptsReturn="True"
                                         MinHeight="44"
                                         KeyDown="OnCompactOverlayTextFieldKeyDown"
                                         LostFocus="OnCompactOverlayTextFieldLostFocus"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>

